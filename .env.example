# NODU Monitor — environment variables
# Copy this to .env and fill in actual values

# Google Gemini API key (AI Studio, not GCP service account)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Reddit API credentials (optional)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Slack webhook (optional)
# For alerts → Slack channel
SLACK_WEBHOOK_URL=your_slack_webhook_url

# N8N webhook (optional)
# For external automation
N8N_WEBHOOK_URL=your_n8n_webhook_url

# --- ALL keys below (and GEMINI/REDDIT above) are read from .env by
# --- env_secrets.py, with config.yaml only as a legacy fallback.
# --- 2026-07-25: the Gemini and YouTube keys were moved out of config.yaml —
# --- that file is git-tracked, and GitHub push protection (rightly) rejects a
# --- commit containing them. The admin UI no longer writes them back either.

# SalesOS Bridge ingest key — the SAME value as BRIDGE_API_KEY in
# C:\NODU\SalesOS\.env. Used by crm/salesos_client.py for the direct
# POST /api/bridge/ingest call (no n8n).
BRIDGE_API_KEY=

# Brave Search API key — replaces the dead Google Custom Search connector.
# Self-serve signup: https://api-dashboard.search.brave.com/register (CAPTCHA)
# Pricing: $5 per 1000 requests, with $5 free credits every month
# (~1000 free requests/month). This system uses ~330/month at the default
# once-daily interval, so it stays inside the free credit.
BRAVE_API_KEY=
